parameters:
  level: 6
  paths:
    - src
    - demo

  # The library supports PHP 7.2 through 8.5. Analysis runs against PHP 8.1;
  # the 7.x resource form is exercised by the CI matrix.
  phpVersion: 80100

  ignoreErrors:
    # PHPStan only sees one arm of the cURL handle union for a single version.
    - identifier: property.unusedType
      path: src/Client.php
